# PRODUÇÃO — referência das variáveis. NÃO comitar segredos reais.
#
# SEGREDOS (CONF-01): use Docker Secrets, não texto puro no docker-stack.yml.
# A app lê segredos via padrão *_FILE (ex.: SESSION_SECRET_FILE=/run/secrets/orbixlead_session_secret).
#
# Gere e crie os segredos antes do deploy:
#   printf '%s' "$(openssl rand -hex 32)" | docker secret create orbixlead_session_secret -
#   printf '%s' "$(openssl rand -hex 32)" | docker secret create orbixlead_internal_api_key -
#   printf '%s' "postgresql://orbixlead:SENHA_FORTE@postgres:5432/orbixlead?schema=public" | docker secret create orbixlead_database_url -
#   printf '%s' "SENHA_SMTP_BREVO"  | docker secret create orbixlead_smtp_pass -            # opcional
#   printf '%s' "SENHA_SUPER_ADMIN" | docker secret create orbixlead_super_admin_password - # opcional
#
# A API FALHA o boot se SESSION_SECRET/INTERNAL_API_KEY estiverem ausentes,
# curtos (SESSION_SECRET < 32, INTERNAL_API_KEY < 16) ou usando placeholder.

# api + scraper (via *_FILE / Docker Secrets)
# DATABASE_URL_FILE=/run/secrets/orbixlead_database_url
# REDIS_URL=redis://redis:6379           # Redis sem senha (aceito: apenas rede interna)

# api
# SESSION_SECRET_FILE=/run/secrets/orbixlead_session_secret
# INTERNAL_API_KEY_FILE=/run/secrets/orbixlead_internal_api_key
# WEB_ORIGIN=https://orbixlead.automacaodebaixocusto.com.br
# COOKIE_SECURE=true
# SUPER_ADMIN_EMAIL=                                  # opcional; vazio = tela /setup
# SUPER_ADMIN_PASSWORD_FILE=/run/secrets/orbixlead_super_admin_password
# SUPER_ADMIN_NAME=Super Admin
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS_FILE=/run/secrets/orbixlead_smtp_pass
# SMTP_FROM=Orbixlead <noreply@automacaodebaixocusto.com.br>

# scraper
# SCRAPER_MODE=playwright
# API_URL=http://api:4000
# INTERNAL_API_KEY_FILE=/run/secrets/orbixlead_internal_api_key   # mesmo secret da api
