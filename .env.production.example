# As variáveis de produção ficam em docker-stack.yml, no bloco environment de cada serviço.
# Este arquivo é só referência do que precisa ser preenchido na stack.

# api + scraper
# DATABASE_URL=postgresql://usuario:senha@host.docker.internal:5432/orbixlead?schema=public
# REDIS_URL=redis://host.docker.internal:6379

# api
# SESSION_SECRET=
# WEB_ORIGIN=https://orbixlead.automacaodebaixocusto.com.br
# COOKIE_SECURE=true
# INTERNAL_API_KEY=
# SUPER_ADMIN_EMAIL=          # opcional; vazio = tela /setup
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super Admin
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Orbixlead <noreply@automacaodebaixocusto.com.br>

# scraper
# SCRAPER_MODE=playwright
# API_URL=http://api:4000
# INTERNAL_API_KEY= (mesmo valor da api)
