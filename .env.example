# Database
DATABASE_URL=postgresql://orbixlead:orbixlead@localhost:5432/orbixlead?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000
SESSION_SECRET=change-me-orbixlead-dev-secret-min-32-chars
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Scraper
SCRAPER_MODE=mock
INTERNAL_API_KEY=orbixlead-internal-dev-key

# Brevo SMTP (optional in dev — links logged to console)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Orbixlead <noreply@orbixlead.local>

# Seed (dev). Em produção, use SUPER_ADMIN_* na stack ou a tela /setup.
SEED_SUPER_ADMIN_EMAIL=admin@orbixlead.local
SEED_SUPER_ADMIN_PASSWORD=Orbixlead@Admin123
SEED_DEMO_ADMIN_EMAIL=demo@orbixlead.local
SEED_DEMO_ADMIN_PASSWORD=Orbixlead@Demo123
SEED_DEMO_OPERADOR_EMAIL=operador@orbixlead.local
SEED_DEMO_OPERADOR_PASSWORD=Orbixlead@Oper123

# Bootstrap de produção (opcional). Só cria se ainda não existir SUPER_ADMIN.
# SUPER_ADMIN_EMAIL=admin@suaempresa.com
# SUPER_ADMIN_PASSWORD=senha-forte-min-8-chars
# SUPER_ADMIN_NAME=Super Admin
